# ============================================================
# Configuration FINGEC - copier ce fichier en .env sur le VPS
#   cp .env.example .env  &&  nano .env
# ============================================================

# --- Public (injecte au build, visible cote client) ---
NEXT_PUBLIC_BASE_URL=https://fingec.fr
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Base de donnees MySQL (newsletter) ---
# Laisser vide tant que la BDD n'est pas en prod.
# Avec le service "db" de docker-compose : DB_HOST=db
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Utilise uniquement par le conteneur MySQL (root)
DB_ROOT_PASSWORD=

# --- Envoi d'emails (contact, candidatures, campagnes) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- Chatbot ---
OPENAI_API_KEY=
